
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Cross-platform line endings
# - Source files stay LF regardless of platform (prevents CRLF parse bugs)
# - Windows-only batch/PS scripts stay CRLF
* text=auto
*.ts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
